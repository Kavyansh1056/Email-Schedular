# Copy this file to apps/api/.env and fill in the real values.
# NEVER commit the real .env file. See README.md for how to obtain each credential.

NODE_ENV=development
PORT=4000
WEB_URL=http://localhost:5173
API_URL=http://localhost:4000

# --- PostgreSQL (matches docker-compose.yml) ---
DATABASE_URL=postgresql://ejs:ejs_password@localhost:5432/email_job_scheduler

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Worker / scheduling tuning ---
WORKER_CONCURRENCY=5
MIN_SEND_DELAY_MS=1000
DEFAULT_MAX_EMAILS_PER_HOUR=200

# --- Ethereal SMTP (see README "Ethereal setup" for how to generate these) ---
ETHEREAL_HOST=smtp.ethereal.email
ETHEREAL_PORT=587
ETHEREAL_USER=
ETHEREAL_PASS=

# --- Google OAuth 2.0 (see README "Google OAuth setup") ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback

# --- Slack OAuth 2.0 (see README "Slack OAuth setup") ---
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:4000/api/slack/callback
SLACK_SIGNING_SECRET=

# --- Elasticsearch ---
ELASTICSEARCH_URL=http://localhost:9200

# --- Auth / secrets ---
JWT_SECRET=replace-with-a-long-random-string
COOKIE_SECRET=replace-with-a-different-long-random-string
# Used to encrypt Slack tokens at rest (32-byte hex key, e.g. `openssl rand -hex 32`)
SLACK_TOKEN_ENCRYPTION_KEY=

# --- Bull Board admin access ---
ADMIN_EMAILS=you@example.com
